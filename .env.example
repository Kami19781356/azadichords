# Copy to .env.local for local dev, or set these in Coolify's
# environment variables for the deployed app. See docs/SALES_SETUP.md
# for what each one is and how to get it.

# --- Postgres (orders + moderation queue) ---
DATABASE_URL=

# --- Stripe (Support page checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TIER_1=
STRIPE_PRICE_ID_TIER_2=
STRIPE_PRICE_ID_TIER_3=

# --- Brevo (transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Hetzner Object Storage (S3-compatible, digital delivery) ---
HETZNER_S3_ENDPOINT=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_BUCKET=

# --- Admin ---
# Shared secret for /admin/founding-supporters (?key=...). Pick
# something long and random — treat it like a password.
ADMIN_SECRET=
