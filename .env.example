# Copy to .env.local for local dev, or set these in the deployed
# app's environment. No payment or database settings: Azadichords
# takes no payments on this site (direct sales live on youality.fr).

# --- Site ---
# Public origin used for canonical URLs, sitemap and social previews.
SITE_URL=https://azadichords.com
# "true" only on production. Anything else (staging) serves a
# robots.txt that blocks all crawlers.
SITE_INDEXABLE=false

# --- Resend (Contact page form notifications) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
